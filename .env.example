# Template for .env, used with docker-compose.env.yml (the Compose file with a
# .env file; the default docker-compose.yml needs no .env). Copy it to .env
# next to the Compose file and adjust the values. Start with
#   docker compose -f docker-compose.env.yml up -d
# or set COMPOSE_FILE=docker-compose.env.yml below.
# .env contains credentials and must never be committed to the repository.
# All variables: docs/variables.md

# === Required ===============================================================
# Use only letters and digits in the password, because it becomes part of a URL.
POSTGRES_DB=contracts_db
POSTGRES_USER=contracts_user
POSTGRES_PASSWORD=CHANGE_ME

# === Optional ===============================================================
# Recommended: host names the app is reached at (comma separated). Without it
# the app accepts every address; links in emails then use the address of the
# app from Administration › Email settings.
# ALLOWED_HOSTS=contracts.example.com
# Full addresses including http:// or https:// the app is reached at. Only
# needed if the reverse proxy changes the address or the scheme.
# CSRF_TRUSTED_ORIGINS=https://contracts.example.com
# True when the app runs behind a reverse proxy with HTTPS
# USE_HTTPS=True
# User and group the app runs as (default 1000). On every start the container
# gives the folders media and config to this user, then drops root.
# APP_UID=1000
# APP_GID=1000
# Your own secret key, e.g. from: openssl rand -hex 32. Without it the app
# creates one in the folder config (config/secret_key).
# SECRET_KEY=

# === Advanced ===============================================================
# Always False in production
# DEBUG=False
# Port on the host that the reverse proxy forwards to
# APP_PORT=8010
# Version of the Docker image (default: latest = newest release). With a fixed
# version, e.g. 0.9.0, "docker compose pull" changes nothing until you
# raise it here.
# APP_IMAGE_TAG=latest
# Database, uploads and key live in the folders db, media and config next to
# the Compose file by default. Only if they live elsewhere (for example in an
# existing installation) set their parent folder here:
# DATA_PATH=/path/to/data
# AI assistant fine tuning (provider, model and key are set in the app):
# thinking depth for Claude (low, medium, high; empty = model default),
# maximum length of one answer, tool rounds per answer, timeout in seconds
# AI_EFFORT=medium
# AI_MAX_TOKENS=16000
# AI_MAX_TOOL_ROUNDS=8
# AI_TIMEOUT=120
# Lockout after failed logins (per user name and IP address)
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=15
# HSTS in seconds, only with USE_HTTPS (e.g. 31536000 = 1 year). Off by
# default, because the Synology reverse proxy can set HSTS itself.
# SECURE_HSTS_SECONDS=0
# Log level of Django in "docker compose logs": DEBUG, INFO, WARNING, ERROR
# DJANGO_LOG_LEVEL=WARNING
# Override the gunicorn options
# GUNICORN_CMD_ARGS=--bind 0.0.0.0:8000 --workers 2 --timeout 60 --no-control-socket
# Only for scripts/backup.sh (installations with a repository): target folder
# and retention of the backups
# BACKUP_DIR=/volume1/docker/contracts-manager/backups
# BACKUP_RETENTION_DAYS=30
# Use docker-compose.env.yml without "-f" on every command
# COMPOSE_FILE=docker-compose.env.yml

# === Archived ===============================================================
# Email, single sign-on, the AI assistant and Paperless are set in the app
# under Administration (superusers, without a restart). Their former variables
# are no longer read since 0.9.0; see docs/variables.md.

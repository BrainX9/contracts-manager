# Template for .env. Copy it to .env and adjust the values.
# .env contains credentials and must never be committed to the repository.

# --- Django ---------------------------------------------------------------
# Generate your own key, e.g. with:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME
# Always False in production
DEBUG=False
# Host names the app is reached at (comma separated).
# localhost is always allowed for the container health check.
ALLOWED_HOSTS=contracts.example.com
# Full addresses including http:// or https:// the app is reached at
# (CSRF protection)
CSRF_TRUSTED_ORIGINS=https://contracts.example.com
# True when the app runs behind a reverse proxy with HTTPS
USE_HTTPS=True

# --- Database -------------------------------------------------------------
# DATABASE_URL is built from these values in docker-compose.yml.
# Use only letters and digits in the password, because it becomes part of a URL.
POSTGRES_DB=contracts_db
POSTGRES_USER=contracts_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Operation ------------------------------------------------------------
# Database and uploads live in the folders db and media next to
# docker-compose.yml by default, e.g. /volume1/docker/contracts-manager/db.
# Create the folders before the first start. Only if they live elsewhere
# (for example in an existing installation) set their parent folder here:
# DATA_PATH=/path/to/data
# Port on the host that the reverse proxy forwards to
APP_PORT=8000
# Version of the Docker image (default: latest = newest release). With a fixed
# version, e.g. 0.2.0, "docker compose pull" changes nothing until you
# raise it here.
# APP_IMAGE_TAG=latest
# User and group the app and worker containers run as (not root).
# The folder media must belong to this user, for example:
#   sudo chown -R 1000:1000 /volume1/docker/contracts-manager/media
# APP_UID=1000
# APP_GID=1000
# Optional, only for scripts/backup.sh (installations with a repository):
# target folder and retention of the backups
# BACKUP_DIR=/volume1/docker/contracts-manager/backups
# BACKUP_RETENTION_DAYS=30
# Optional: override the gunicorn options
# GUNICORN_CMD_ARGS=--bind 0.0.0.0:8000 --workers 2 --timeout 60 --no-control-socket

# --- First administrator (optional) ---------------------------------------
# On the first start an administrator (superuser) is created from these
# values, but only if no superuser exists yet. Later changes have no effect.
# After the first login change the password in the app (Settings) and remove
# ADMIN_PASSWORD from this file.
# Alternative: docker compose exec app python manage.py createsuperuser
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_EMAIL=

# --- Paperless-ngx (optional) ---------------------------------------------
# Address of Paperless for links to documents and correspondents, without a
# trailing slash. Leave empty if you do not want links.
PAPERLESS_URL=

# --- AI assistant (optional) ----------------------------------------------
# Members of the group "KI" and superusers may use it.
# AI_PROVIDER: "openai" (OpenAI and OpenAI-compatible providers such as the
# IONOS AI Model Hub, Mistral or Ollama via AI_BASE_URL) or "anthropic"
# (Claude). Questions and the contract data they need are sent to the chosen
# provider.
# Example Claude:
# AI_ENABLED=True
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# Thinking depth for Claude: low, medium or high (empty = model default);
# low or medium is usually enough for questions about contracts
# AI_EFFORT=medium
# Only for other providers: OpenAI-compatible address from the provider's
# documentation
# AI_BASE_URL=
# AI_MAX_TOKENS=16000
# AI_MAX_TOOL_ROUNDS=8
# AI_TIMEOUT=120

# --- Email (SMTP, optional) -----------------------------------------------
# For password reset, invitations and reminders. Without EMAIL_HOST, emails
# are only written to the log. Example (port 587 with STARTTLS):
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=contracts@example.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Contracts Manager <contracts@example.com>
# Public address of the app, used for links in emails (no trailing slash)
APP_BASE_URL=https://contracts.example.com
# Time of the daily reminder emails (service "worker")
# REMINDER_SEND_TIME=07:00

# --- Single sign-on with the Synology SSO Server (optional) ---------------
# See docs/configuration.md, section "Single sign-on".
OIDC_ENABLED=False
# Address of the SSO server (HTTPS), without a trailing slash
# OIDC_OP_BASE_URL=https://nas.example.com
# OIDC_RP_CLIENT_ID=
# OIDC_RP_CLIENT_SECRET=
# Create unknown users on their first login (default: False)
# OIDC_CREATE_USERS=False
# Optional: claim that contains the user name. Administrators change the label
# of the sign-in button under Administration › System.
# OIDC_USERNAME_CLAIM=username
# Optional: requested scopes and the signing algorithm of the ID token
# OIDC_RP_SCOPES=openid email
# OIDC_RP_SIGN_ALGO=RS256
# Optional, only for providers other than the Synology SSO Server: the
# endpoints. By default they are derived from OIDC_OP_BASE_URL:
# OIDC_OP_AUTHORIZATION_ENDPOINT=https://nas.example.com/webman/sso/SSOOauth.cgi
# OIDC_OP_TOKEN_ENDPOINT=https://nas.example.com/webman/sso/SSOAccessToken.cgi
# OIDC_OP_USER_ENDPOINT=https://nas.example.com/webman/sso/SSOUserInfo.cgi
# OIDC_OP_JWKS_ENDPOINT=https://nas.example.com/webman/sso/openid-jwks.json

# --- Security (optional) --------------------------------------------------
# Lockout after failed logins (per user name and IP address)
# AXES_FAILURE_LIMIT=5
# AXES_COOLOFF_MINUTES=15
# HSTS in seconds, only with USE_HTTPS (e.g. 31536000 = 1 year). Off by
# default, because the Synology reverse proxy can set HSTS itself.
# SECURE_HSTS_SECONDS=0

# --- Logging (optional) ---------------------------------------------------
# Log level of Django in "docker compose logs": DEBUG, INFO, WARNING, ERROR
# DJANGO_LOG_LEVEL=WARNING

# --- Development ----------------------------------------------------------
# For local development see docs/development.md.

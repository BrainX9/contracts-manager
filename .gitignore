# Zugangsdaten und lokale Daten (nie ins Repository)
.env
data/
media/
backups/
# Erzeugter SECRET_KEY (Version 0.9.0; Entwicklung: config-data)
config-data/
config/secret_key
config/.secret_key*
# Backups der Anwendung (export_backup, Download aus der Oberfläche)
/*.zip

# Python und Django
__pycache__/
*.pyc
staticfiles/
venv/
# Kompilierte Übersetzungen (entstehen beim Bauen bzw. Start des Containers)
*.mo

# macOS
.DS_Store

# Auslagerungsdateien von Editoren (können Inhalte der .env enthalten)
*.swp
*.swo
